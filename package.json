{
  "name": "claude-activity-widget",
  "version": "0.1.0",
  "description": "Always-on-top desktop widget showing Claude Code activity and real Anthropic usage limits",
  "main": "./out/main/index.js",
  "author": "kurious",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.kurious.claudeactivitywidget",
    "productName": "Claude Activity Widget",
    "directories": { "output": "dist" },
    "files": ["out/**/*", "resources/**/*"],
    "win": { "target": "nsis" }
  }
}
